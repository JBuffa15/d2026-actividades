generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Libro {
  id      Int    @id @default(autoincrement())
  titulo  String
  autor   String
  anio    String
  imgSrc  String
}

model Autor {
  id            Int    @id @default(autoincrement())
  nombre        String
  nacionalidad  String
}