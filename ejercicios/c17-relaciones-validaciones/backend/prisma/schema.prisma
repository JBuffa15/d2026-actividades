generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Autor {
  id           Int     @id @default(autoincrement())
  nombre       String  @unique
  nacionalidad String
  libros       Libro[]
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}

model Libro {
  id         Int         @id @default(autoincrement())
  titulo     String
  anio       String
  imgSrc     String
  autorId    Int
  autor      Autor       @relation(fields: [autorId], references: [id], onDelete: Restrict)
  categorias Categoria[]
}